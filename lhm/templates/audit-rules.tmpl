# ===== lhm audit rules =====
# Managed by lhm (/etc/audit/rules.d/99-lhm.rules). Remove to revert.
# Load with: augenrules --load

-D
-b 8192
-f 1
--backlog_wait_time 60000

# Login/identity
-w /var/log/faillog -p wa -k logins
-w /var/log/lastlog -p wa -k logins
-w /var/run/utmp -p wa -k session
-w /var/log/btmp -p wa -k logins

# User/group/cron manipulation
-w /etc/group -p wa -k identity
-w /etc/passwd -p wa -k identity
-w /etc/gshadow -p wa -k identity
-w /etc/shadow -p wa -k identity
-w /etc/sudoers -p wa -k scope
-w /etc/sudoers.d/ -p wa -k scope
-w /etc/cron.d/ -p wa -k cron
-w /etc/cron.daily/ -p wa -k cron
-w /etc/cron.hourly/ -p wa -k cron
-w /etc/cron.weekly/ -p wa -k cron
-w /etc/cron.monthly/ -p wa -k cron

# SSH config
-w /etc/ssh/sshd_config -p wa -k sshd
-w /etc/ssh/sshd_config.d/ -p wa -k sshd

# Systemd / units
-w /etc/systemd/system/ -p wa -k systemd
-w /etc/systemd/system/.d/ -p wa -k systemd

# Audit config itself
-w /etc/audit/ -p wa -k auditconfig

# Network / firewall config
-w /etc/nftables.conf -p wa -k firewall
-w /etc/ufw/ -p wa -k firewall

# Kernel module + sysctl
-a always,exit -F arch=b64 -S init_module -F auid>=1000 -F auid!=unset -k modules
-a always,exit -F arch=b64 -S finit_module -F auid>=1000 -F auid!=unset -k modules
-a always,exit -F arch=b64 -S delete_module -F auid>=1000 -F auid!=unset -k modules
-a always,exit -F arch=b64 -S execve -F euid=0 -F auid>=1000 -F auid!=unset -k root-cmd

# Immutable: must be last
-e 2
