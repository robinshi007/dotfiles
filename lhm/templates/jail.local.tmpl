# ===== lhm fail2ban jail.local =====
# Managed by lhm (/etc/fail2ban/jail.local). Remove to revert.
# backend=systemd: no log file polling, reads journald instead.

[DEFAULT]
backend = systemd
banaction = nftables-multiport
bantime  = ${bantime}
findtime = ${findtime}
maxretry = ${maxretry}
destemail = root
sender = fail2ban@${hostname}
action = %(action_)s

[sshd]
enabled = true
port = ${ssh_port}
mode = aggressive
maxretry = ${maxretry}
